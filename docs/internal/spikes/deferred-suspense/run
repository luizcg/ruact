#!/usr/bin/env bash
# Story 19-0 — the whole experiment, from a clean checkout:
#
#   ./run                 install, build, browser proof (dev + production), HTTP measurements
#   ./run browser         only the browser runs
#   ./run measure         only the HTTP measurements (writes results/http.md)
#   ./run react 19.2.8    the browser proof with the app's own react-server-dom-webpack
#
# Needs Ruby (bundler), Node and curl; `ab` for one measurement. Uses ports 4190 and 5199.
set -euo pipefail
cd "$(dirname "$0")"

setup() {
  for port in 4190 5199; do
    if lsof -ti "tcp:$port" >/dev/null 2>&1; then echo "port $port is in use" >&2; exit 1; fi
  done
  mkdir -p tmp log results
  bundle install --quiet
  npm ci --silent
  npx playwright install chromium >/dev/null
  npx vite build >/dev/null
}

browser() {
  for env in development production; do
    for mode in live body; do
      echo "== prototype ($mode), $env"
      SPIKE_MODE=$mode RAILS_ENV=$env npx playwright test
    done
    echo "== ruact as released, $env: what it does today"
    SPIKE_MODE=baseline RAILS_ENV=$env npx playwright test baseline.spec.mjs
    echo "== ruact as released, $env: the proof must FAIL"
    if SPIKE_MODE=baseline RAILS_ENV=$env npx playwright test deferred.spec.mjs >tmp/baseline-proof.log 2>&1; then
      echo "the proof passed against the released gem: it proves nothing" >&2
      exit 1
    fi
    grep -E "✘|failed" tmp/baseline-proof.log
    echo "== the streamed document read by the bootstrap 0.0.19 ships, $env"
    SPIKE_OLD_CLIENT=1 SPIKE_MODE=live RAILS_ENV=$env npx playwright test
  done
}

# The plugin uses the app's react-server-dom-webpack when package.json declares it.
other_react() {
  local version=$1
  cp package.json tmp/package.json.keep
  cp package-lock.json tmp/package-lock.json.keep
  restore() {
    cp tmp/package.json.keep package.json
    cp tmp/package-lock.json.keep package-lock.json
    npm ci --silent
  }
  trap restore EXIT
  npm install --silent "react@$version" "react-dom@$version" "react-server-dom-webpack@$version"
  npx vite build | grep "Flight client"
  for env in development production; do
    for mode in live body; do
      echo "== prototype ($mode), $env, React $version"
      SPIKE_MODE=$mode RAILS_ENV=$env npx playwright test
    done
  done
}

case "${1:-all}" in
  all)     setup; browser; bundle exec ruby measure/measure.rb ;;
  browser) setup; browser ;;
  measure) setup; bundle exec ruby measure/measure.rb ;;
  react)   setup; other_react "${2:?version}" ;;
  *)       echo "usage: ./run [browser|measure|react VERSION]" >&2; exit 1 ;;
esac

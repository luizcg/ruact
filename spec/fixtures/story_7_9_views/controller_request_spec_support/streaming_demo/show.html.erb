      <% ControllerRequestSpecSupport.record(:inner, response.committed?) %>
      <p>inner</p>
    </Suspense>
  </Suspense>
  <Suspense fallback="Loading two">
    <% ControllerRequestSpecSupport.record(:two, response.committed?) %>
    <p>two <%= "<b>escaped</b>" %></p>
  </Suspense>
</main>

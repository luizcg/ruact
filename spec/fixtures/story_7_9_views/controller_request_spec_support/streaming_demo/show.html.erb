<main>
  <% ControllerRequestSpecSupport.record(:shell, response.committed?) %>
  <p>shell</p>
  <Suspense fallback="Loading one">
    <% ControllerRequestSpecSupport.record(:one, response.committed?) %>
    <p><%= t(".lazy") %></p>
    <DemoButton n={1} />

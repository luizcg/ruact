<!DOCTYPE html>
<html>
  <head>
    <title>deferred Suspense</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= ruact_head_assets %>
  </head>
  <body>
    <%# Story 19-2 (AC3.3) — an image of the layout, outside #root, still loading. %>
    <% if params[:img] %><img id="logo" src="/__held/img.png" alt="logo"><% end %>
    <%# Story 19-2 (AC5.1) — a layout that raises: before any byte is sent. %>
    <% raise "the layout raised" if params[:layout_raises] %>
    <% if params[:assets_first] %>
      <%= ruact_js_assets %>
      <div id="root"></div>
    <% else %>
      <div id="root"></div>
      <%= ruact_js_assets %>
    <% end %>
  </body>
</html>

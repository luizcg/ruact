  <p id="a"><%= Gate.wait("a") %></p>
  <% Harness::Events.add("block_end:a") %>
</Suspense>
<Suspense fallback="Loading B…">
  <% Harness::Events.add("block_start:b") %>
  <p id="b"><%= Gate.wait("b") %></p>
  <% Harness::Events.add("block_end:b") %>
</Suspense>

{
  "env": "development",
  "nginx": "nginx version: nginx/1.24.0 (Ubuntu)",
  "defaults": {
    "first_load_shell_before_the_gate": false,
    "navigation_shell_before_the_gate": false,
    "ac20_warning_logged": true
  },
  "proxy_http_version 1.1": {
    "first_load_shell_before_the_gate": true,
    "navigation_shell_before_the_gate": true
  },
  "proxy_http_version 1.1, gzip on": {
    "first_load_shell_before_the_gate": true,
    "navigation_shell_before_the_gate": true
  }
}

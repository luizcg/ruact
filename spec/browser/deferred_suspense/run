#!/usr/bin/env bash
# Story 19-1 — the browser proof of deferred <Suspense>, against the gem:
#
#   ./run                 install, build, the scenarios in development and production,
#                         and the perturbation that must fail (writes results/browser.md)
#   ./run react 19.2.8    the same scenarios with the app's own react-server-dom-webpack
#                         (appends to results/browser.md)
#   ./run i18n 1.14.7     the middleware-scope scenario with another i18n
#   ./run rack 2.2.24     the proof and the lifecycle with Rack 2.2
#   ./run skew            the streamed document read by 0.0.19's bootstrap, and the server
#                         saying so (Story 19-3): production, development, the perturbation
#   ./run upgrade         the vite.config.js ruact:install writes, across an upgrade of the
#                         gem: a rebuild uses the new plugin (Story 19-4); the perturbation
#   ./run pg              the PostgreSQL scenarios (also part of ./run when initdb is on the PATH)
#   ./run postgres        what suspense_timeout does to a query running in PostgreSQL
#                         (writes results/postgres.md; needs initdb and pg_ctl)
#
# Needs Ruby (bundler) and Node. Uses ports 4190, 4191 (the threads scenario's
# control listener), 4192 (nginx, when it is on the PATH) and 5199. Runs from a
# `git archive` of the repository in an empty directory, too.
set -euo pipefail
cd "$(dirname "$0")"

BROWSER=results/browser.md

setup() {
  for port in 4190 4191 4192 5199; do
    if lsof -ti "tcp:$port" >/dev/null 2>&1; then echo "port $port is in use" >&2; exit 1; fi
  done
  mkdir -p tmp log results
  bundle install --quiet
  npm ci --silent
  npx playwright install chromium >/dev/null
}

build() {
  npx vite build --config vite.config.mjs >tmp/build.log
  grep -o "Flight client: .*" tmp/build.log
}

# One Playwright run, its outcome a row of results/browser.md. A failing run
# stops the script (pipefail).
row() {
  local what=$1 env=$2 log=$3
  local outcome
  outcome=$(grep -E "^ +[0-9]+ (passed|failed|skipped)" "$log" | sed -E 's/^ +//; s/ \([0-9.]+m?s\)//' | paste -sd, - | sed 's/,/, /g')
  echo "| $what | $env | $outcome |" >>"$BROWSER"
}

scenarios() {
  local what=$1 env=$2
  shift 2
  echo "== $what, $env"
  env "$@" RAILS_ENV="$env" npx playwright test 2>&1 | tee tmp/playwright.log
  row "$what" "$env" tmp/playwright.log
}

table() {
  {
    echo
    echo "## $1"
    echo
    echo "| what ran | environment | outcome |"
    echo "| --- | --- | --- |"
  } >>"$BROWSER"
}

# With every <Suspense> rendered in place (what 0.0.19 did), the proof must
# fail — both scenarios, each at what the browser shows.
perturbation() {
  local env=$1
  echo "== in place: the proof must FAIL, $env"
  if HARNESS_IN_PLACE=1 RAILS_ENV=$env npx playwright test deferred.spec.mjs >tmp/in-place.log 2>&1; then
    echo "the proof passed with every <Suspense> rendered in place: it proves nothing" >&2
    exit 1
  fi
  grep -E "✘|failed" tmp/in-place.log
  grep -q "2 failed" tmp/in-place.log
  grep -q "locator('#shell')" tmp/in-place.log
  grep -q "toHaveURL" tmp/in-place.log
  echo "| every \`<Suspense>\` in place: \`deferred.spec.mjs\` | $env | 2 failed, as it must: at the shell's text and at the URL |" >>"$BROWSER"
}

# Story 19-2 (AC21) — with the rows pushed without the nonce, the content of
# a first load must never arrive under the policy.
csp_perturbation() {
  local env=$1
  echo "== CSP, rows without the nonce: must FAIL, $env"
  if HARNESS_CSP=1 HARNESS_CSP_PERTURB=1 RAILS_ENV=$env npx playwright test csp.spec.mjs -g "first load" >tmp/csp.log 2>&1; then
    echo "the CSP scenario passed with the rows pushed without a nonce: it proves nothing" >&2
    exit 1
  fi
  grep -q "1 failed" tmp/csp.log
  grep -q 'Expected: "open:a"' tmp/csp.log
  node -e 'const r = require("./results/csp-perturbation-'"$env"'.json"); if (!r.refused.some((v) => v.startsWith("script-src"))) process.exit(1)'
  echo "| a CSP by nonce, rows pushed without it | $env | 1 failed, as it must: the content never arrives, the browser refused the script |" >>"$BROWSER"
}

browser() {
  echo "# Story 19-1 — browser runs" >"$BROWSER"
  echo >>"$BROWSER"
  echo "Written by \`./run\`: one row per Playwright run, Chromium, one worker, against the gem in this checkout." >>"$BROWSER"
  table "React $(node -p "require('react/package.json').version") — $(build)"
  for env in development production; do
    scenarios "the scenarios" "$env"
    perturbation "$env"
    scenarios "a CSP by nonce, without 'unsafe-inline'" "$env" HARNESS_CSP=1
    csp_perturbation "$env"
    scenarios "Puma with 3 threads (\`e2e/threads.spec.mjs\`)" "$env" HARNESS_THREADS=3
    if command -v nginx >/dev/null; then
      scenarios "nginx in front of Puma (\`e2e/nginx.spec.mjs\`)" "$env" HARNESS_NGINX=1
    elif [ -n "${CI:-}" ]; then
      echo "nginx is required on CI: none on the PATH" >&2
      exit 1
    else
      echo "| nginx in front of Puma | $env | not run: no nginx on the PATH |" >>"$BROWSER"
    fi
  done
}

# The plugin uses the app's react-server-dom-webpack when package.json declares it.
other_react() {
  local version=$1
  cp package.json tmp/package.json.keep
  cp package-lock.json tmp/package-lock.json.keep
  restore() {
    cp tmp/package.json.keep package.json
    cp tmp/package-lock.json.keep package-lock.json
    npm ci --silent
  }
  trap restore EXIT
  npm install --silent "react@$version" "react-dom@$version" "react-server-dom-webpack@$version"
  table "React $(node -p "require('react/package.json').version") — $(build)"
  for env in development production; do
    scenarios "the scenarios" "$env" HARNESS_VARIANT="react-$version"
  done
}

# AC5.4 — what suspense_timeout does to a query running in PostgreSQL, on a
# throwaway server of its own (needs initdb and pg_ctl on the PATH).
postgres() {
  bundle install --quiet
  mkdir -p results
  PG_DIR=$(mktemp -d)
  initdb -D "$PG_DIR/data" --auth=trust >/dev/null
  pg_ctl -D "$PG_DIR/data" -o "-p 5498 -k $PG_DIR -c listen_addresses=''" -l "$PG_DIR/log" -w start >/dev/null
  trap 'pg_ctl -D "$PG_DIR/data" -m immediate stop >/dev/null; rm -rf "$PG_DIR"' EXIT
  bundle exec ruby measure/postgres.rb "$PG_DIR" 5498
}

# Story 19-2 (AC13) — the same app on a throwaway PostgreSQL: the scenarios of
# e2e/postgres.spec.mjs, without and with the async query executor. Needs
# initdb and pg_ctl on the PATH.
pg() {
  build >/dev/null
  PG_DIR=$(mktemp -d)
  initdb -D "$PG_DIR/data" --auth=trust >/dev/null
  pg_ctl -D "$PG_DIR/data" -o "-p 5498 -k $PG_DIR -c listen_addresses=''" -l "$PG_DIR/log" -w start >/dev/null
  trap 'pg_ctl -D "$PG_DIR/data" -m immediate stop >/dev/null; rm -rf "$PG_DIR"' EXIT
  export DATABASE_URL="postgres:///postgres?host=$PG_DIR&port=5498&pool=10"
  table "PostgreSQL $(pg_ctl --version | awk '{print $3}') — e2e/postgres.spec.mjs, suspense_timeout 5 s"
  for env in development production; do
    scenarios "PostgreSQL" "$env" HARNESS_DB=postgres HARNESS_TIMEOUT=5
    scenarios "PostgreSQL, async query executor" "$env" HARNESS_DB=postgres HARNESS_TIMEOUT=5 HARNESS_ASYNC=1
  done
}

# Story 19-2 (AC17) — the middleware scenario with another i18n (the ADR's
# "i18n before 1.15"): ./run i18n 1.14.7. Appends to results/browser.md.
other_i18n() {
  local version=$1
  cp Gemfile tmp/Gemfile.keep
  cp Gemfile.lock tmp/Gemfile.lock.keep
  restore_gems() {
    cp tmp/Gemfile.keep Gemfile
    cp tmp/Gemfile.lock.keep Gemfile.lock
    bundle install --quiet
  }
  trap restore_gems EXIT
  echo "gem \"i18n\", \"$version\"" >>Gemfile
  bundle install --quiet
  table "i18n $version — e2e/middleware.spec.mjs"
  for env in development production; do
    echo "== i18n $version, $env"
    HARNESS_VARIANT="i18n-$version" RAILS_ENV=$env npx playwright test middleware.spec.mjs 2>&1 | tee tmp/playwright.log
    row "middleware scopes" "$env" tmp/playwright.log
  done
}

# What this run wrote is newer than this stamp (CI prints only that).
mkdir -p tmp && touch tmp/run-started

# Story 19-2 (AC19.3) — the proof with Rack 2.2, whose ETag middleware
# buffers a body it digests: ./run rack 2.2.24. Appends to results/browser.md.
other_rack() {
  local version=$1
  cp Gemfile tmp/Gemfile.keep
  cp Gemfile.lock tmp/Gemfile.lock.keep
  restore_gems() {
    cp tmp/Gemfile.keep Gemfile
    cp tmp/Gemfile.lock.keep Gemfile.lock
    bundle install --quiet
  }
  trap restore_gems EXIT
  echo "gem \"rack\", \"$version\"" >>Gemfile
  bundle install --quiet
  table "Rack $(bundle exec ruby -e 'require "rack"; print Rack.release') — e2e/deferred.spec.mjs, e2e/lifecycle.spec.mjs"
  for env in development production; do
    echo "== Rack $version, $env"
    HARNESS_VARIANT="rack-$version" RAILS_ENV=$env npx playwright test deferred.spec.mjs lifecycle.spec.mjs 2>&1 | tee tmp/playwright.log
    row "the proof and the lifecycle" "$env" tmp/playwright.log
    echo "== Rack $version without ruact's ETag: the proof must FAIL, $env"
    if HARNESS_NO_RACK2_ETAG=1 RAILS_ENV=$env npx playwright test deferred.spec.mjs >tmp/rack-etag.log 2>&1; then
      echo "the proof passed on Rack 2 without ruact's ETag: Rack::ETag no longer buffers, or the proof proves nothing" >&2
      exit 1
    fi
    grep -q "2 failed" tmp/rack-etag.log
    echo "| the proof without ruact's ETag | $env | 2 failed, as it must: Rack::ETag held the page |" >>"$BROWSER"
  done
}

# Story 19-2 (AC22) — the streamed document read by 0.0.19's bootstrap: the
# assets built with that release's plugin (from `git archive v0.0.19`), the
# server this checkout. Appends to results/browser.md, then builds the assets
# back with this checkout's plugin.
#
# Story 19-3 — and the server says so: production with 0.0.19's build, then
# development with Vite's dev server running 0.0.19's plugin (what a
# vite.config.js importing an old gem's plugin does). Then the perturbation:
# with every build taken for this ruact's, the detection must FAIL.
skew() {
  local old=tmp/plugin-0.0.19
  rm -rf "$old" && mkdir -p "$old"
  git -C ../../.. archive v0.0.19 vendor/javascript/vite-plugin-ruact | tar -x -C "$old"
  trap 'unset HARNESS_PLUGIN_DIR; build >/dev/null' EXIT
  export HARNESS_PLUGIN_DIR="$PWD/$old/vendor/javascript/vite-plugin-ruact"
  npx vite build --config vite.config.mjs >tmp/build-0.0.19.log
  table "0.0.19's bootstrap, this server — e2e/skew.spec.mjs"
  local env
  for env in production development; do
    echo "== skew, $env"
    HARNESS_SKEW=1 RAILS_ENV=$env npx playwright test 2>&1 | tee tmp/playwright.log
    local seen
    seen=$(RAILS_ENV=$env node -e '
      const env = process.env.RAILS_ENV;
      const r = require(`./results/skew-${env}.json`);
      const d = require(`./results/skew-detected-${env}.json`);
      const end = r.when_it_ends;
      const shown = end.b ? "the content shown" : end.fallback_still_shown ? "the fallback stays, the content never shown" : "nothing shown";
      const said = [`logged ${d.log.length}x`, `doctor ${d.doctor.status}`, d.banner ? "banner on the page" : "no banner"].join(", ");
      console.log(`measured: ${shown}; ${r.errors.length} distinct error(s)${r.errors[0] ? ": " + r.errors[0].slice(0, 90) : ""}. Detected (19-3): ${said}`);
    ')
    echo "| the streamed document read by 0.0.19's bootstrap | $env | $seen |" >>"$BROWSER"
  done

  # The perturbation writes its results under its own name (HARNESS_VARIANT),
  # never over the detection's.
  for env in production development; do
    echo "== skew without the detection: must FAIL, $env"
    if HARNESS_SKEW=1 HARNESS_NO_SKEW_CHECK=1 HARNESS_VARIANT=no-skew-check RAILS_ENV=$env npx playwright test >tmp/no-skew-check.log 2>&1; then
      echo "the skew run passed with every build taken for this ruact's: it proves nothing" >&2
      exit 1
    fi
    local what
    local -a musts=("1 failed" "Error: the log of the build's version" "Error: the doctor's manifest check")
    [ "$env" = development ] && musts+=("Error: the banner on the page")
    for what in "${musts[@]}"; do
      grep -qF "$what" tmp/no-skew-check.log || { echo "the perturbation did not fail at: $what (tmp/no-skew-check.log)" >&2; exit 1; }
    done
    local at="the log and the doctor"
    [ "$env" = development ] && at="the log, the doctor and the banner"
    echo "| every build taken for this ruact's: \`skew.spec.mjs\` | $env | 1 failed, as it must: at $at |" >>"$BROWSER"
  done
}

# Story 19-4 — the vite.config.js `ruact:install` writes asks Bundler for the
# plugin, so after `bundle update ruact` a rebuild uses the new one. With
# 0.0.21 extracted beside this checkout (`git archive v0.0.21`, from the gem's
# root) as the gem installed before the upgrade:
#   before   tmp/Gemfile.0.0.21 (ruact from 0.0.21): the generated config builds
#            with 0.0.21's plugin, whose manifest records no version
#   after    this harness's Gemfile, the same config file unedited: the build
#            is this ruact's, and Story 19-3's detection says nothing
#   pinned   the perturbation — the config `ruact:install` wrote before 19-4,
#            importing 0.0.21's plugin by its path: the detection fires
# The config is the app's ./vite.config.js (where the detection reads its
# import), written by the generator itself, and listens on the template's 5173.
upgrade() {
  if lsof -ti tcp:5173 >/dev/null 2>&1; then echo "port 5173 is in use" >&2; exit 1; fi
  # Outside the gem's tree: the gem's own rspec and rubocop would take 0.0.21's
  # specs for this checkout's.
  UPGRADE_DIR=$(mktemp -d)
  local old="$UPGRADE_DIR/ruact-0.0.21"
  rm -rf tmp/generated vite.config.js && mkdir -p "$old"
  trap 'rm -f vite.config.js; rm -rf "$UPGRADE_DIR"; build >/dev/null' EXIT
  git -C ../../.. archive v0.0.21 | tar -x -C "$old"
  sed "s#path: \"../../..\"#path: \"$old\"#" Gemfile >tmp/Gemfile.0.0.21
  grep -qF "path: \"$old\"" tmp/Gemfile.0.0.21 || { echo "tmp/Gemfile.0.0.21 does not point ruact at $old" >&2; exit 1; }
  cp Gemfile.lock tmp/Gemfile.0.0.21.lock
  BUNDLE_GEMFILE="$PWD/tmp/Gemfile.0.0.21" bundle install --quiet
  bundle exec ruby -e 'require "generators/ruact/install/install_generator"
    Ruact::Generators::InstallGenerator.new([], {}, destination_root: ARGV[0]).create_vite_config' tmp/generated
  local plugin="$old/vendor/javascript/vite-plugin-ruact/index.js"
  sed "s#__RUACT_VITE_PLUGIN_PATH__#$plugin#" ../../../lib/generators/ruact/install/legacy/vite.config.pinned.js >tmp/vite.config.pinned.js
  grep -qF "import ruact from '$plugin';" tmp/vite.config.pinned.js || { echo "tmp/vite.config.pinned.js does not import $plugin" >&2; exit 1; }
  recorded() { node -p 'JSON.stringify(JSON.parse(require("fs").readFileSync("public/react-client-manifest.json", "utf8")).__ruact__?.version ?? null)'; }

  table "the vite.config.js ruact:install writes, across an upgrade — e2e/upgrade.spec.mjs"
  cp tmp/generated/vite.config.js vite.config.js
  echo "== upgrade: before, ruact from 0.0.21"
  BUNDLE_GEMFILE="$PWD/tmp/Gemfile.0.0.21" npx vite build --config vite.config.js >tmp/build-upgrade-before.log
  local before
  before=$(recorded)
  [ "$before" = null ] || { echo "before the upgrade the build recorded $before: the config did not follow Bundler" >&2; exit 1; }
  echo "| before: Bundler has 0.0.21, \`vite build\` | — | built by 0.0.21's plugin (no version recorded) |" >>"$BROWSER"

  echo "== upgrade: after, ruact from this checkout, the same file"
  cmp -s tmp/generated/vite.config.js vite.config.js || { echo "vite.config.js changed between the builds" >&2; exit 1; }
  npx vite build --config vite.config.js >tmp/build-upgrade-after.log
  local after
  after=$(recorded)
  local version
  version=$(ruby -e 'require "../../../lib/ruact/version"; print Ruact::VERSION.dump')
  [ "$after" = "$version" ] || { echo "after the upgrade the build recorded $after, not $version" >&2; exit 1; }
  local env
  for env in production development; do
    echo "== upgrade, the generated config: quiet, $env"
    HARNESS_UPGRADE=quiet HARNESS_VITE_CONFIG=vite.config.js VITE_PORT=5173 RAILS_ENV=$env npx playwright test 2>&1 | tee tmp/playwright.log
    echo "| after: this ruact, the same file, rebuilt — the detection says nothing | $env | $(grep -E "^ +[0-9]+ (passed|failed)" tmp/playwright.log | sed -E 's/^ +//; s/ \([0-9.]+m?s\)//') (built by ${after//\"/}) |" >>"$BROWSER"
  done

  cp tmp/vite.config.pinned.js vite.config.js
  npx vite build --config vite.config.js >tmp/build-upgrade-pinned.log
  local pinned
  pinned=$(recorded)
  for env in production development; do
    echo "== upgrade, the config pinned on 0.0.21: the detection fires, $env"
    HARNESS_UPGRADE=pinned HARNESS_VITE_CONFIG=vite.config.js VITE_PORT=5173 RAILS_ENV=$env npx playwright test 2>&1 | tee tmp/upgrade-pinned.log
    echo "== upgrade, the config pinned on 0.0.21, quiet: must FAIL, $env"
    if HARNESS_UPGRADE=quiet HARNESS_VARIANT=pinned HARNESS_VITE_CONFIG=vite.config.js VITE_PORT=5173 RAILS_ENV=$env npx playwright test >tmp/upgrade-pinned-quiet.log 2>&1; then
      echo "the quiet assertions passed with the config pinned on 0.0.21: they prove nothing" >&2
      exit 1
    fi
    local what
    local -a musts=("Error: the log of the build's version" "Error: the doctor's manifest check")
    [ "$env" = development ] && musts+=("Error: the banner on the page")
    for what in "${musts[@]}"; do
      grep -qF "$what" tmp/upgrade-pinned-quiet.log || { echo "with the pinned config, quiet did not fail at: $what (tmp/upgrade-pinned-quiet.log)" >&2; exit 1; }
    done
    local at="the log and the doctor"
    [ "$env" = development ] && at="the log, the doctor and the banner"
    echo "| the perturbation: the config pinned on 0.0.21 (built by ${pinned/null/no version}) | $env | the detection fires and names the import; the quiet assertions fail, as they must: at $at |" >>"$BROWSER"
  done
}

case "${1:-all}" in
  # On CI PostgreSQL is required (AC24.1): a runner without it fails the run.
  all)      setup; browser
            if command -v initdb >/dev/null; then pg
            elif [ -n "${CI:-}" ]; then echo "PostgreSQL is required on CI: no initdb on the PATH" >&2; exit 1
            else echo "| PostgreSQL | — | not run: no initdb on the PATH |" >>"$BROWSER"; fi ;;
  pg)       setup; pg ;;
  i18n)     setup; build >/dev/null; other_i18n "${2:?version}" ;;
  rack)     setup; build >/dev/null; other_rack "${2:?version}" ;;
  skew)     setup; skew ;;
  upgrade)  setup; upgrade ;;
  react)    setup; other_react "${2:?version}" ;;
  postgres) postgres ;;
  *)        echo "usage: ./run [react VERSION | i18n VERSION | rack VERSION | skew | upgrade | pg | postgres]" >&2; exit 1 ;;
esac

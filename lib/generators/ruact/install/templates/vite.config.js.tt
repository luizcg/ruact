import { execSync } from 'node:child_process';
import { pathToFileURL } from 'node:url';
import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';

// ruact's Vite plugin ships inside the ruact gem. Bundler is asked where that
// gem is each time Vite starts, so after `bundle update ruact` the next build
// (or bin/dev) uses the new plugin: no path to refresh in this file.
// Where Bundler cannot run (a build stage without Ruby), RUACT_VITE_PLUGIN_PATH
// names the plugin's index.js instead — a fixed path, to update with the gem.
function ruactPluginPath() {
  const pinned = process.env.RUACT_VITE_PLUGIN_PATH;
  if (pinned) return pinned;

  let out;
  try {
    out = execSync(`bundle exec ruby -e "require 'ruact'; print Ruact.vite_plugin_path"`, {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'pipe'],
    });
  } catch (error) {
    throw new Error(
      "[ruact] could not ask Bundler where the ruact gem is. Run Vite from the app's root, " +
        'where `bundle exec` works (bin/dev, npm run build), or set RUACT_VITE_PLUGIN_PATH.\n' +
        (error.stderr || error.message),
    );
  }
  // The last line only: anything a gem prints while loading comes before it.
  const path = out.trim().split(/\r?\n/).pop();
  if (!path) throw new Error('[ruact] Bundler gave no path for the ruact gem.');
  return path;
}

export default defineConfig(async () => {
  const { default: ruact } = await import(pathToFileURL(ruactPluginPath()).href);

  return {
    // ruact puts nothing in Vite's public dir, and Rails serves public/: without
    // this, every build copies public/ into public/assets/.
    publicDir: false,

    plugins: [
      react(),
      ruact(), // scans app/javascript/components/ for "use client", emits react-client-manifest.json
    ],

    build: {
      outDir: 'public/assets',
      manifest: true,
      rollupOptions: {
        // ruact's bootstrap entry is a virtual module served by the plugin above
        // (Story 14.2) — there is no app/javascript/application.jsx to point at.
        input: '<%= Ruact.bootstrap_virtual_id %>',
      },
    },

    server: {
      port: 5173,
      strictPort: true,
      origin: 'http://localhost:5173',
    },
  };
});

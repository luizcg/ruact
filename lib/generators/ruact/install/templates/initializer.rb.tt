# frozen_string_literal: true

Ruact.configure do |config|
<% if app? -%>
  # Whole-app mode (`rails generate ruact:install --app`): ApplicationController
  # includes Ruact::Controller, so every action with an .html.erb template
  # renders through ruact, into your own layout. That layout needs
  # `<%%= ruact_head_assets %>` in <head> and `<%%= ruact_js_assets %>` next to a
  # `<div id="root"></div>` (`rails ruact:doctor` checks).
  config.layout = true
<% else -%>
  # Island mode: nothing in your controllers changed. A page renders through
  # ruact when its controller has `include Ruact::Controller` — narrow it to
  # some actions with `ruact_pages only: %i[show]`.
  #
  # Ruact pages render through the layout ruact ships (layouts/ruact). It links
  # the CSS your client components import, then the stylesheets below — yours
  # load last, so they win ties — and it edits none of your layouts. What it
  # does NOT bring is the rest of your own layout's <head> or your app's
  # JavaScript; to own that document, copy it into your app with
  # `rails generate ruact:layout`.
  #
  # Set to true to render through your app's own layout instead (it then needs
  # `<%%= ruact_head_assets %>` in <head> and `<%%= ruact_js_assets %>` next to a
  # `<div id="root"></div>`; `rails ruact:doctor` checks), or false for ruact's
  # minimal built-in shell, which carries none of your stylesheets.
  config.layout = "ruact"

  # The app stylesheets ruact's layout links, as you would pass them to
  # stylesheet_link_tag. [:app] under Propshaft is every stylesheet you have.
  config.layout_stylesheets = <%= detected_layout_stylesheets %>
<% end -%>

  # Path to the react-client-manifest.json generated by the Vite plugin.
  # Defaults to Rails.root.join("public/react-client-manifest.json").
  # config.manifest_path = Rails.root.join("public", "react-client-manifest.json")

  # When true, objects without explicit ruact_props declaration raise
  # Ruact::SerializationError instead of falling back to as_json.
  # Recommended: true in production to prevent accidental attribute exposure.
  # config.strict_serialization = Rails.env.production?

  # Timeout in seconds for deferred Suspense chunks. Default: 5.0.
  # config.suspense_timeout = 5.0

  # Base URL of the Vite dev server. Default: "http://localhost:5173".
  # config.vite_dev_server = "http://localhost:5173"
end

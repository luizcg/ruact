{
  "name": "<%= app_package_name %>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build"<% if shadcn? %>,
    "build:css": "<%= SHADCN_BUILD_CSS_SCRIPT %>"<% end %>
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
<% if shadcn? -%>
<% SHADCN_DEV_DEPENDENCIES.each do |name, version| -%>
    "<%= name %>": "<%= version %>",
<% end -%>
<% end -%>
    "vite": "^6.0.7"
  }
}
